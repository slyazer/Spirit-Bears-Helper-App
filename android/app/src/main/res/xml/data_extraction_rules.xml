<?xml version="1.0" encoding="utf-8"?>
<!--
  The session token is encrypted with a non-exportable Android Keystore key that
  is NOT backed up or transferred, so restoring the encrypted blob elsewhere is
  useless and only needlessly exposes it. Exclude the prefs file — the user signs
  in again after a restore / new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="macro_monitor_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="macro_monitor_settings.xml" />
    </device-transfer>
</data-extraction-rules>
