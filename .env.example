# Macro Monitor bridge — example environment file.
# Copy to `.env` and fill in real values. NEVER commit your real `.env`.
# On Windows, restrict this file:  icacls .env /inheritance:r /grant:r "%USERNAME%:R"

# --- Server binding -------------------------------------------------------
# Bind to loopback by default. To use over Tailscale, set MM_HOST to your
# Tailscale IP (e.g. 100.x.y.z) or 0.0.0.0 if you understand the risk and have
# a host firewall that only allows the tailnet interface.
MM_HOST=127.0.0.1
MM_PORT=8787

# Max seconds a cached Natro read is considered fresh before marking stale.
MM_STALE_AFTER_SECONDS=180

# --- Authentication -------------------------------------------------------
# Generate a long random token, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The Android app stores this in encrypted preferences.
MM_API_TOKEN=CHANGEME_use_a_long_random_token

# --- Accounts config file -------------------------------------------------
# Path to the JSON/YAML account list (see bridge/config/accounts.example.json).
MM_ACCOUNTS_FILE=config/accounts.json

# --- Optional: Discord API base (leave default unless testing) ------------
MM_DISCORD_API_BASE=https://discord.com/api/v10

# --- Optional: rate limiting ----------------------------------------------
MM_RATE_LIMIT_PER_MINUTE=120
