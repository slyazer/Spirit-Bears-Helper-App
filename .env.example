# Macro Monitor bridge — example environment file.
# Copy to `.env` and fill in real values. NEVER commit your real `.env`.
# On Windows, restrict this file:  icacls .env /inheritance:r /grant:r "%USERNAME%:R"
#
# NOTE: run the bundled setup wizard (setup.ps1) and it will create this file,
# a login account, and start the bridge for you. Hand-editing is only needed
# for advanced/headless setups.

# --- Server binding -------------------------------------------------------
# Default to all interfaces so phones on the same LAN (and your Tailscale
# tailnet) can reach the bridge. Keep this service OFF the public internet:
# there is no TLS termination and no public exposure by design.
MM_HOST=0.0.0.0
MM_PORT=8787

# Max seconds a cached Natro read is considered fresh before marking stale.
MM_STALE_AFTER_SECONDS=180

# Max seconds a Roblox private-server population capture stays "fresh" before
# the app flags it as stale (last-known value). The capture agent refreshes well
# within this window; it only covers a temporarily failing capture.
MM_ROBLOX_POPULATION_STALE_SECONDS=900

# --- Authentication -------------------------------------------------------
# There is no shared API token any more. Accounts live in users_file and are
# created with `python -m app.cli create-user <name>` (or the setup wizard).
# Passwords are hashed with Argon2id and never stored in plaintext.
MM_USERS_FILE=config/users.json
MM_SESSIONS_FILE=config/sessions.json

# Session lifetime: absolute TTL and inactivity timeout, in seconds.
MM_SESSION_TTL_SECONDS=2592000
MM_SESSION_IDLE_SECONDS=604800

# Login throttling: lock a client/username after N failures within the window.
MM_LOGIN_MAX_ATTEMPTS=8
MM_LOGIN_WINDOW_SECONDS=300
MM_LOGIN_LOCKOUT_SECONDS=300

# --- Pairing & LAN discovery ---------------------------------------------
# QR pairing lets a phone join without typing an address. Discovery advertises
# the bridge on the local network via mDNS so the app finds it automatically.
MM_PAIRING_FILE=config/pairing.json
MM_PAIRING_TTL_SECONDS=600
MM_ENABLE_PAIRING=true
MM_ENABLE_MDNS=true
MM_SERVICE_NAME=Macro Monitor Bridge

# --- Accounts config file -------------------------------------------------
# Path to the JSON account list (see bridge/config/accounts.example.json).
MM_ACCOUNTS_FILE=config/accounts.json

# --- Optional: TLS --------------------------------------------------------
# Provide both to serve HTTPS (recommended if you ever leave a trusted LAN).
# MM_TLS_CERT_FILE=config/server.crt
# MM_TLS_KEY_FILE=config/server.key

# --- Optional: Discord API base (leave default unless testing) ------------
MM_DISCORD_API_BASE=https://discord.com/api/v10

# --- Optional: rate limiting ----------------------------------------------
MM_RATE_LIMIT_PER_MINUTE=120
